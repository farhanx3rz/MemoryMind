# MemoryMind Environment Configuration Template
# Copy this file to "backend/.env" and fill in your values.
# The .env file is strictly gitignored so secrets are never committed.

# --- LLM Provider Selection ---
# Options: grok | gemini | openai | anthropic | ollama | none
# "none" runs in Offline / Echo Mode (useful for testing without API keys)
LLM_PROVIDER=grok

# --- xAI Grok ---
XAI_API_KEY=
GROK_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Ollama (Local Self-Hosted) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Dynamic Concept Extraction ---
MEMORY_EXTRACTION=false
DYNAMIC_TAGS_ENABLED=true
DYNAMIC_TAG_MIN=3
DYNAMIC_TAG_MAX=8

# --- Hybrid Retrieval Weights ---
# Final Score = (Semantic * 0.55) + (Keyword * 0.20) + (Topic * 0.10) + (Tag * 0.15)
HYBRID_SEMANTIC_WEIGHT=0.55
HYBRID_KEYWORD_WEIGHT=0.20
HYBRID_TOPIC_WEIGHT=0.10
HYBRID_TAG_WEIGHT=0.15
HYBRID_MIN_SCORE=0.25
HYBRID_SEMANTIC_CANDIDATES=48
CHUNKS_PER_SOURCE=2
SOURCE_TOP_K=8

# --- Paths & Server ---
CHROMA_PATH=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Retrieval Thresholds ---
TOP_K=8
MIN_SCORE=0.3

# --- Generic Webpage Ingestion ---
WEBPAGE_CHUNK_SIZE=220
WEBPAGE_CHUNK_OVERLAP=40
MIN_EXTRACTED_CHARS=400
WEBPAGE_MAX_HTML_CHARS=3000000

# --- Hugging Face Model Hosting ---
# Automatically downloads and caches the topic classifier weights from Hugging Face.
# Model repo: https://huggingface.co/farhanx3rz/memorymind-classifier
HF_MODEL_REPO=farhanx3rz/memorymind-classifier
HF_MODEL_REVISION=main
HF_TOKEN=

