# Copy this to "backend/.env" (same folder) and fill in your real values.
# That file is gitignored, so your secrets are never committed.
# Never copy the key into the Chrome extension or any committed file.

# Which LLM provider to use: gemini | grok | openai | anthropic | ollama | none
# "none" makes the app echo the best matching memory, which is handy for
# testing retrieval without an API key.
LLM_PROVIDER=grok


# --- xAI Grok ---
XAI_API_KEY=
GROK_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

# --- Google Gemini ---
# The free tier allows roughly 20 requests per day, which is enough for a
# personal MVP. Create a key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Set to false to store the selected text as-is and skip the LLM call that
# condenses it. This keeps one Grok call per saved memory for dynamic tags.
MEMORY_EXTRACTION=false

# --- Dynamic tags ---
# Grok extracts a small set of fine-grained concepts in addition to
# DistilBERT's controlled topic taxonomy.
DYNAMIC_TAGS_ENABLED=true
DYNAMIC_TAG_MIN=3
DYNAMIC_TAG_MAX=8

# --- Hybrid retrieval ---
# Final retrieval score = weighted semantic + keyword + topic + tag scores.
HYBRID_SEMANTIC_WEIGHT=0.55
HYBRID_KEYWORD_WEIGHT=0.20
HYBRID_TOPIC_WEIGHT=0.10
HYBRID_TAG_WEIGHT=0.15
HYBRID_MIN_SCORE=0.25
HYBRID_SEMANTIC_CANDIDATES=48
CHUNKS_PER_SOURCE=2
SOURCE_TOP_K=8

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Ollama (local, no key needed) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Paths / server ---
CHROMA_PATH=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Retrieval ---
# How many distinct source documents to return for a question.
TOP_K=8
# Memories scoring below this cosine similarity are treated as irrelevant.
# Real matches score 0.5-0.9, unrelated text scores near 0.1.
MIN_SCORE=0.3

# Generic webpage ingestion
WEBPAGE_CHUNK_SIZE=220
WEBPAGE_CHUNK_OVERLAP=40
MIN_EXTRACTED_CHARS=400
WEBPAGE_MAX_HTML_CHARS=3000000

# --- Hugging Face Model Hosting ---
# Automatically downloads and caches the topic classifier weights from Hugging Face.
# Model repo: farhanx3rz/memorymind-classifier
HF_MODEL_REPO=farhanx3rz/memorymind-classifier
HF_MODEL_REVISION=main
HF_TOKEN=
