{
  "manifest_version": 3,
  "name": "MemoryMind",
  "version": "1.0.0",
  "description": "Save selected text or the current webpage from any site and ask questions about what you saved.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "<all_urls>",
    "file:///*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "MemoryMind",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdfsummarizer/pdf.html",
        "pdfsummarizer/pdf.js",
        "pdfsummarizer/pdf.css",
        "research/research.html",
        "research/research.js",
        "research/research.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
